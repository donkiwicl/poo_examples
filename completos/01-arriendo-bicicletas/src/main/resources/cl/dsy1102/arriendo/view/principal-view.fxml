<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.arriendo.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Arriendo Cerro Alegre" styleClass="titulo"/>
            <Label text="Bicicletas y scooters · Valparaíso" styleClass="subtitulo"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Código o modelo" HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkSoloDisponibles" text="Solo disponibles"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblVehiculos">
            <placeholder>
                <Label text="No hay vehículos para mostrar. Usa &quot;Nuevo&quot; para registrar uno."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="220"/>
                <TableColumn fx:id="colTarifa" text="Tarifa/hora" prefWidth="110" styleClass="numero"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                <TableColumn fx:id="colBateria" text="Batería" prefWidth="90" styleClass="numero"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo" styleClass="primario"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            <Pane prefWidth="16"/>
            <Button fx:id="btnArrendar" text="Arrendar" onAction="#onArrendar"/>
            <Button fx:id="btnDevolver" text="Devolver" onAction="#onDevolver"/>
            <Button fx:id="btnRecargar" text="Recargar" onAction="#onRecargar"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="contador"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
