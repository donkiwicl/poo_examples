<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.biblioteca.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Biblioteca Gabriela Mistral" styleClass="titulo"/>
            <Label text="Colección de libros y revistas · Préstamo a domicilio" styleClass="subtitulo"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Título o código" HBox.hgrow="ALWAYS"/>
                <Label text="Tipo:"/>
                <ComboBox fx:id="cmbTipo" prefWidth="130"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblMateriales">
            <placeholder>
                <Label text="No hay materiales para mostrar. Usa &quot;Nuevo&quot; para registrar uno."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="300"/>
                <TableColumn fx:id="colAnio" text="Año" prefWidth="70" styleClass="numero"/>
                <TableColumn fx:id="colDisponibles" text="Disponibles" prefWidth="110" styleClass="numero"/>
                <TableColumn fx:id="colPrestamo" text="Préstamo" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo" styleClass="primario"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            <Pane prefWidth="16"/>
            <Button fx:id="btnPrestar" text="Prestar" onAction="#onPrestar"/>
            <Button fx:id="btnDevolver" text="Devolver" onAction="#onDevolver"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="contador"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
