<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!-- Maestro-detalle: arriba el paciente, al centro su historial, abajo el registro de una atencion. -->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.veterinaria.controller.FichaController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="10">
            <Label fx:id="lblTitulo" text="Ficha clínica" styleClass="titulo"/>
            <Label fx:id="lblDetalle" styleClass="grupo" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"/>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <VBox spacing="6">
            <TableView fx:id="tblAtenciones" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Sin atenciones registradas."/></placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                    <TableColumn fx:id="colTipo" text="Atención" prefWidth="150"/>
                    <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="80" styleClass="numero"/>
                    <TableColumn fx:id="colCosto" text="Costo" prefWidth="90" styleClass="numero"/>
                    <TableColumn fx:id="colObservacion" text="Observación" prefWidth="250"/>
                </columns>
            </TableView>
            <Label fx:id="lblResumen" styleClass="contador"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10">
            <TitledPane text="Registrar atención" collapsible="false">
                <VBox spacing="10">
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="60"/>
                            <ColumnConstraints prefWidth="160"/>
                            <ColumnConstraints minWidth="60"/>
                            <ColumnConstraints prefWidth="180"/>
                            <ColumnConstraints minWidth="70"/>
                            <ColumnConstraints prefWidth="90"/>
                        </columnConstraints>
                        <Label text="Fecha" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dpFecha" GridPane.columnIndex="1"/>
                        <Label text="Tipo" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="cmbTipoAtencion" promptText="Selecciona" maxWidth="Infinity" GridPane.columnIndex="3"/>
                        <Label text="Peso (kg)" GridPane.columnIndex="4"/>
                        <TextField fx:id="txtPeso" GridPane.columnIndex="5"/>
                        <Label text="Observación" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtObservacion" promptText="Opcional, hasta 200 caracteres"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="5"/>
                    </GridPane>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnRegistrar" text="Registrar" onAction="#onRegistrar" styleClass="primario" defaultButton="true"/>
                        <Label fx:id="lblCosto" styleClass="subtitulo"/>
                    </HBox>
                    <Label fx:id="lblResultado" wrapText="true" styleClass="resultado"/>
                </VBox>
            </TitledPane>
            <HBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" cancelButton="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
