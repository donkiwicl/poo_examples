<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.veterinaria.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Clínica Veterinaria Patitas del Sur" styleClass="titulo"/>
            <Label text="Pacientes e historial clínico · Puerto Varas" styleClass="subtitulo"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Nombre del paciente o del tutor" HBox.hgrow="ALWAYS"/>
                <Label text="Especie:"/>
                <ComboBox fx:id="cmbEspecie" prefWidth="130"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblPacientes">
            <placeholder>
                <Label text="No hay pacientes para mostrar. Usa &quot;Nuevo&quot; para registrar uno."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colEspecie" text="Especie" prefWidth="90"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colTutor" text="Tutor" prefWidth="180"/>
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="60" styleClass="numero"/>
                <TableColumn fx:id="colUltimaAtencion" text="Última atención" prefWidth="140"/>
                <TableColumn fx:id="colTotal" text="Total atenciones" prefWidth="130" styleClass="numero"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo" styleClass="primario"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            <Pane prefWidth="16"/>
            <Button fx:id="btnFicha" text="Ficha clínica" onAction="#onFicha"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="contador"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
