<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.almacen.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Almacén Don Kiwi" styleClass="titulo"/>
            <Label text="Inventario · Valparaíso" styleClass="subtitulo"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Nombre o código" HBox.hgrow="ALWAYS"/>
                <Label text="Categoría:"/>
                <ComboBox fx:id="cmbCategoria" prefWidth="140"/>
                <Button fx:id="btnRecargar" text="Recargar" onAction="#onRecargar" minWidth="-Infinity"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblProductos">
            <placeholder>
                <Label text="No hay productos para mostrar. Usa &quot;Nuevo&quot; para registrar uno."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="110"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90" styleClass="numero"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="70" styleClass="numero"/>
                <TableColumn fx:id="colVence" text="Vence" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox fx:id="barraAcciones" spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo" styleClass="primario" minWidth="-Infinity"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar" minWidth="-Infinity"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro" minWidth="-Infinity"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="contador"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
