<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.almacen.controller.ReportesController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="10">
            <Label text="Reportes de ventas" styleClass="titulo"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde" prefWidth="140"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta" prefWidth="140"/>
                <Button fx:id="btnConsultar" text="Consultar" onAction="#onConsultar" styleClass="primario" minWidth="-Infinity"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblResumen" styleClass="total"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Ventas por categoría" styleClass="subtitulo"/>
                <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Sin ventas en el período."/></placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140"/>
                        <TableColumn fx:id="colUnidadesCategoria" text="Unidades" prefWidth="90" styleClass="numero"/>
                        <TableColumn fx:id="colTotalCategoria" text="Total" prefWidth="110" styleClass="numero"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Los 5 productos más vendidos" styleClass="subtitulo"/>
                <TableView fx:id="tblMasVendidos" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Sin ventas en el período."/></placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="200"/>
                        <TableColumn fx:id="colUnidades" text="Unidades" prefWidth="80" styleClass="numero"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100" styleClass="numero"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="8">
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" minWidth="-Infinity"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
