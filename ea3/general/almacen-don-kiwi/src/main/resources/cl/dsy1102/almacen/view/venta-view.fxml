<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.almacen.controller.VentaController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="10">
            <Label text="Nueva venta" styleClass="titulo"/>
            <Label fx:id="lblFecha" styleClass="subtitulo"/>
            <VBox spacing="8" styleClass="grupo">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Producto:"/>
                    <ComboBox fx:id="cmbProducto" promptText="Selecciona un producto" prefWidth="380"/>
                    <Label text="Cantidad:"/>
                    <Spinner fx:id="spnCantidad" prefWidth="90"/>
                    <Button fx:id="btnAgregar" text="Agregar" onAction="#onAgregar" styleClass="primario" minWidth="-Infinity"/>
                </HBox>
                <Label fx:id="lblPrecio" styleClass="contador"/>
            </VBox>
            <Label fx:id="lblMensaje" styleClass="resultado"/>
            <padding><Insets bottom="10"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblLineas">
            <placeholder>
                <Label text="Agrega productos a la venta."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="280"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80" styleClass="numero"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" styleClass="numero"/>
                <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="110" styleClass="numero"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnQuitar" text="Quitar línea" onAction="#onQuitar" styleClass="peligro" minWidth="-Infinity"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="total"/>
            <Pane prefWidth="16"/>
            <Button fx:id="btnConfirmar" text="Confirmar venta" onAction="#onConfirmar" styleClass="primario" minWidth="-Infinity"/>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#onCancelar" minWidth="-Infinity"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
