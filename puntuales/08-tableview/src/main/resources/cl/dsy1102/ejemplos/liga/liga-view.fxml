<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.ejemplos.liga.LigaController"
            stylesheets="@estilos.css" styleClass="vista">
    <top>
        <VBox spacing="10">
            <Label text="Liga Vecinal Cordillera · Baby Fútbol" styleClass="titulo"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Nombre del equipo" HBox.hgrow="ALWAYS"/>
                <Label text="Comuna:"/>
                <ComboBox fx:id="cmbComuna" prefWidth="190"/>
            </HBox>
            <BorderPane.margin><Insets bottom="10"/></BorderPane.margin>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblEquipos">
            <placeholder><Label text="Ningún equipo coincide con el filtro."/></placeholder>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colPosicion" text="#" prefWidth="40" sortable="false" styleClass="numero"/>
                <TableColumn fx:id="colNombre" text="Equipo" prefWidth="220"/>
                <TableColumn fx:id="colComuna" text="Comuna" prefWidth="150"/>
                <TableColumn fx:id="colJugados" text="PJ" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colGanados" text="PG" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colEmpatados" text="PE" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colPerdidos" text="PP" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colGolesFavor" text="GF" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colGolesContra" text="GC" prefWidth="50" styleClass="numero"/>
                <TableColumn fx:id="colDiferencia" text="DIF" prefWidth="55" styleClass="numero"/>
                <TableColumn fx:id="colPuntos" text="PTS" prefWidth="60" styleClass="numero, puntos"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="lblTotal" styleClass="contador"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEliminar" text="Eliminar equipo" onAction="#onEliminar" styleClass="peligro"/>
            </HBox>
            <HBox spacing="10">
                <TitledPane text="Registrar resultado" collapsible="false" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cmbLocal" promptText="Local" prefWidth="200"/>
                        <TextField fx:id="txtGolesLocal" prefWidth="45" promptText="0"/>
                        <Label text="-"/>
                        <TextField fx:id="txtGolesVisita" prefWidth="45" promptText="0"/>
                        <ComboBox fx:id="cmbVisita" promptText="Visita" prefWidth="200"/>
                        <Button fx:id="btnRegistrar" text="Registrar" onAction="#onRegistrar" styleClass="primario" minWidth="-Infinity"/>
                    </HBox>
                </TitledPane>
                <TitledPane text="Nuevo equipo" collapsible="false">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtNuevoNombre" promptText="Nombre" prefWidth="130"/>
                        <TextField fx:id="txtNuevaComuna" promptText="Comuna" prefWidth="100"/>
                        <Button fx:id="btnAgregar" text="Agregar" onAction="#onAgregar" minWidth="-Infinity"/>
                    </HBox>
                </TitledPane>
            </HBox>
            <BorderPane.margin><Insets top="10"/></BorderPane.margin>
        </VBox>
    </bottom>
</BorderPane>
