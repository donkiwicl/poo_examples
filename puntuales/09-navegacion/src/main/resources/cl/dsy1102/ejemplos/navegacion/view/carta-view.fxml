<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.ejemplos.navegacion.controller.CartaController"
            stylesheets="@estilos.css" styleClass="vista">
    <top>
        <VBox spacing="8">
            <Label text="Picada La Tía Rosa" styleClass="titulo"/>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="barra-pedido">
                <Label fx:id="lblPedido"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVerPedido" text="Ver pedido" onAction="#onVerPedido"/>
            </HBox>
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
        </VBox>
    </top>
    <center>
        <ListView fx:id="lstPlatos"/>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="lblMensaje" styleClass="mensaje-ok" wrapText="true"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVerDetalle" text="Ver detalle" onAction="#onVerDetalle" styleClass="primario" defaultButton="true"/>
            <BorderPane.margin><Insets top="12"/></BorderPane.margin>
        </HBox>
    </bottom>
</BorderPane>
