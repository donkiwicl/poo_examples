<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana modal: se abre encima de la principal y la bloquea hasta cerrarse. -->
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.dsy1102.ejemplos.navegacion.controller.ConfirmacionController"
      stylesheets="@estilos.css" styleClass="vista" spacing="10" prefWidth="360">
    <Label fx:id="lblTotal" styleClass="subtotal"/>
    <Label text="¿A nombre de quién dejamos el pedido?"/>
    <TextField fx:id="txtNombre" promptText="Nombre para el retiro"/>
    <Label fx:id="lblError" styleClass="mensaje-error"/>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#onCancelar" cancelButton="true"/>
        <Button fx:id="btnAceptar" text="Confirmar" onAction="#onAceptar" styleClass="primario" defaultButton="true"/>
    </HBox>
</VBox>
