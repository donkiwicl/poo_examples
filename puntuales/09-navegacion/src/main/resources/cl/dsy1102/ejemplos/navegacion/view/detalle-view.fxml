<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.ejemplos.navegacion.controller.DetalleController"
            stylesheets="@estilos.css" styleClass="vista">
    <top>
        <Label fx:id="lblNombre" styleClass="titulo">
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="14" styleClass="grupo">
            <Label fx:id="lblDescripcion" wrapText="true"/>
            <Label fx:id="lblPrecio" styleClass="precio"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Cantidad:"/>
                <Spinner fx:id="spnCantidad" prefWidth="90"/>
            </HBox>
            <Label fx:id="lblSubtotal" styleClass="subtotal"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" cancelButton="true"/>
            <Button fx:id="btnAgregar" text="Agregar al pedido" onAction="#onAgregar" styleClass="primario" defaultButton="true"/>
            <BorderPane.margin><Insets top="12"/></BorderPane.margin>
        </HBox>
    </bottom>
</BorderPane>
